---
import Tags from "@/components/Tags.astro";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { workData } from "@/lib/work";
---

<div class="flex flex-col gap-4">
  {
    workData.map(job => (
      <article>
        <Card variant="accent" cornerAccent>
          <CardHeader>
            <CardTitle className="flex justify-between items-start flex-wrap gap-2">
              <h3 class="text-xl font-semibold tracking-tight">
                {job.role}
                <span class="font-normal text-primary"> · {job.company}</span>
              </h3>
              <div class="font-mono text-xs font-normal text-muted-foreground">
                {job.period}
              </div>
            </CardTitle>
            <CardDescription className="max-w-prose text-[15px] whitespace-pre-line">
              {job.description}
            </CardDescription>
          </CardHeader>

          {job.tags && (
            <CardContent>
              <Tags tags={job.tags} variant="outline-card" />
            </CardContent>
          )}
        </Card>
      </article>
    ))
  }
</div>
