---
import Tags from "@/components/Tags.astro";
import { workData } from "@/lib/work";
---

<div class="flex flex-col gap-4">
  {
    workData.map(job => (
      <article class="border border-border border-l-2 border-l-primary bg-card px-6 py-6">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="text-xl font-semibold tracking-tight">
            {job.role}
            <span class="font-normal text-primary"> · {job.company}</span>
          </h3>
          <span class="font-mono text-xs text-muted-foreground">
            {job.period}
          </span>
        </div>

        <p class="mt-3 max-w-prose text-[15px] text-muted-foreground">
          {job.description}
        </p>

        {job.tags && (
          <Tags tags={job.tags} variant="outline-card" class="mt-4" />
        )}
      </article>
    ))
  }
</div>
