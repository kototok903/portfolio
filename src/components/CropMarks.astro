---
/*
  Fixed registration/crop marks in each viewport corner — the framing motif
  that anchors the "paper terminal" look. Decorative only.
*/
---

<div
  class="pointer-events-none fixed inset-0 z-50 hidden sm:block"
  aria-hidden="true"
>
  <span
    class="absolute top-3.5 left-3.5 size-5 border-t-2 border-l-2 border-primary"
  ></span>
  <span
    class="absolute top-3.5 right-3.5 size-5 border-t-2 border-r-2 border-primary"
  ></span>
  <span
    class="absolute bottom-3.5 left-3.5 size-5 border-b-2 border-l-2 border-primary"
  ></span>
  <span
    class="absolute right-3.5 bottom-3.5 size-5 border-r-2 border-b-2 border-primary"
  ></span>
</div>
