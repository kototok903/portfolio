---
/*
  Fixed registration/crop marks in each viewport corner — the framing motif
  that anchors the "paper terminal" look. Decorative only.
*/
---

<div
  class="pointer-events-none fixed inset-0 z-50 hidden sm:block"
  aria-hidden="true"
>
  <span
    class="absolute top-4 left-4 size-5 border-t-2 border-l-2 border-primary/85"
  ></span>
  <span
    class="absolute top-4 right-4 size-5 border-t-2 border-r-2 border-primary/85"
  ></span>
  <span
    class="absolute bottom-4 left-4 size-5 border-b-2 border-l-2 border-primary/85"
  ></span>
  <span
    class="absolute right-4 bottom-4 size-5 border-r-2 border-b-2 border-primary/85"
  ></span>
</div>
