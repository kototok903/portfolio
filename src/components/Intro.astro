---
import { Image } from "astro:assets";
import { LinkButton } from "@/components/LinkButton";
import GithubIcon from "@/components/icons/GithubIcon.astro";
import LinkedinIcon from "@/components/icons/LinkedinIcon.astro";
import { Button } from "@/components/ui/button";
import { Card, CardBar } from "@/components/ui/card";
import authorImage from "@/assets/images/author/stas_3to4.jpg";
import { GITHUB_URL, LINKEDIN_URL } from "@/lib/constants";
---

<section
  id="intro"
  class="mx-auto max-w-5xl scroll-mt-24 px-5 pt-16 pb-24 sm:px-10 md:pt-24 md:pb-32"
>
  <div class="flex flex-wrap-reverse items-center justify-between gap-10">
    <div class="flex-1">
      <h1 class="mt-5 font-serif text-5xl tracking-tight italic">
        <span class="text-primary">Stas</span>{" "}
        Bronevskiy
      </h1>

      <p class="mt-4 max-w-md text-muted-foreground">
        Computer-science student at Iowa State with past work experience as a
        software engineer. In code I value clarity and efficiency. Love
        designing systems.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <LinkButton href="/resume" variant="handle">Resume</LinkButton>
        <LinkButton
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          variant="frame"
          size="icon"
        >
          <GithubIcon aria-label="GitHub" />
        </LinkButton>
        <LinkButton
          href={LINKEDIN_URL}
          target="_blank"
          rel="noopener noreferrer"
          variant="frame"
          size="icon"
        >
          <LinkedinIcon aria-label="LinkedIn" />
        </LinkButton>
      </div>
    </div>
    <Card
      className="mx-auto w-full max-w-50 gap-0 border-border-strong py-0 shadow-lg"
      data-intro-image-card
    >
      <CardBar>
        <span>stas.jpg</span>
        <span class="flex gap-1.5">
          <span class="size-2 bg-border-strong"></span>
          <span class="size-2 bg-border-strong"></span>
          <Button
            type="button"
            variant="windowControl"
            size="windowControl"
            aria-label="Hide portrait"
            data-hide-intro-image
          />
        </span>
      </CardBar>
      <Image
        class="aspect-3/4 w-full object-cover"
        src={authorImage}
        alt="Stas Bronevskiy"
        width={200}
        densities={[1, 2]}
        quality={85}
        priority
      />
    </Card>
  </div>
</section>

<script>
  const hideImageButton = document.querySelector<HTMLButtonElement>(
    "[data-hide-intro-image]",
  );
  const imageCard = document.querySelector<HTMLElement>(
    "[data-intro-image-card]",
  );

  hideImageButton?.addEventListener("click", () => {
    imageCard?.classList.add("invisible");
    hideImageButton?.classList.add("transition-none");
  });
</script>
