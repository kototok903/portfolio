---
import { actions } from "astro:actions";
import { Button } from "@/components/ui/button";
import {
  Field,
  FieldError,
  FieldGroup,
  FieldLabel,
} from "@/components/ui/field";
import { Input } from "@/components/ui/input";
import { Spinner } from "@/components/ui/spinner";
import { Textarea } from "@/components/ui/textarea";
import { CONTACT_EMAIL } from "@/lib/constants";
---

<div class="mx-auto max-w-xl text-center">
  <h3 class="font-sans text-4xl font-bold tracking-tight sm:text-5xl">
    Let&rsquo;s <span class="font-serif font-normal text-primary italic"
      >build</span
    > something.
  </h3>
  <p class="mt-4 text-muted-foreground">
    Open to internships, new-grad roles, and interesting problems. Use the form
    below, or email{" "}
    <a
      href={`mailto:${CONTACT_EMAIL}`}
      class="font-mono text-sm text-primary-hi hover:text-primary hover:underline"
      >{CONTACT_EMAIL}</a
    >.
  </p>

  <form
    method="POST"
    action={actions.sendContact}
    class="mt-8 text-left"
    data-contact-form
  >
    <div class="hidden" aria-hidden>
      <label>
        Website
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <FieldGroup className="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <Field data-contact-field="name">
        <FieldLabel htmlFor="name" className="sr-only">Name</FieldLabel>
        <Input
          id="name"
          name="name"
          type="text"
          placeholder="Name"
          autoComplete="given-name"
          aria-describedby="name-error"
          data-contact-control
          minLength={2}
          required
        />
        <FieldError id="name-error" data-contact-error hidden>
          <span></span>
        </FieldError>
      </Field>

      <Field data-contact-field="email">
        <FieldLabel htmlFor="email" className="sr-only">Email</FieldLabel>
        <Input
          id="email"
          name="email"
          type="email"
          autoComplete="email"
          aria-describedby="email-error"
          data-contact-control
          placeholder="Email"
          required
        />
        <FieldError id="email-error" data-contact-error hidden>
          <span></span>
        </FieldError>
      </Field>

      <Field className="sm:col-span-2" data-contact-field="message">
        <FieldLabel htmlFor="message" className="sr-only">Message</FieldLabel>
        <Textarea
          id="message"
          name="message"
          rows={4}
          aria-describedby="message-error"
          data-contact-control
          placeholder="Message"
          required
        />
        <FieldError id="message-error" data-contact-error hidden>
          <span></span>
        </FieldError>
      </Field>
    </FieldGroup>

    <div class="mt-6">
      <Button
        type="submit"
        variant="handle"
        className="w-full"
        data-contact-submit
      >
        <Spinner
          className="hidden"
          data-icon="inline-start"
          data-contact-spinner
        />
        <span data-contact-submit-label>Send message</span>
      </Button>
    </div>

    <p
      class="mt-4 min-h-5 text-center text-sm text-muted-foreground"
      data-contact-status
      aria-live="polite"
      role="status"
    >
    </p>
  </form>
</div>

<script>
  import { actions, isInputError } from "astro:actions";

  type ContactFieldName = "name" | "email" | "message";

  const fieldNames: ContactFieldName[] = ["name", "email", "message"];

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const submit = document.querySelector<HTMLButtonElement>(
    "[data-contact-submit]",
  );
  const status = document.querySelector<HTMLElement>("[data-contact-status]");
  const spinner = document.querySelector<SVGElement>("[data-contact-spinner]");
  const submitLabel = document.querySelector<HTMLElement>(
    "[data-contact-submit-label]",
  );

  function getFieldElements(name: ContactFieldName) {
    const field = document.querySelector<HTMLElement>(
      `[data-contact-field="${name}"]`,
    );

    return {
      field,
      control: field?.querySelector<HTMLInputElement | HTMLTextAreaElement>(
        "[data-contact-control]",
      ),
      error: field?.querySelector<HTMLElement>("[data-contact-error]"),
    };
  }

  function clearFieldError(name: ContactFieldName) {
    const { field, control, error } = getFieldElements(name);

    field?.removeAttribute("data-invalid");
    control?.removeAttribute("aria-invalid");

    if (error) {
      error.textContent = "";
      error.hidden = true;
    }
  }

  function clearFieldErrors() {
    fieldNames.forEach(clearFieldError);
  }

  function setFieldError(name: ContactFieldName, message: string) {
    const { field, control, error } = getFieldElements(name);

    field?.setAttribute("data-invalid", "true");
    control?.setAttribute("aria-invalid", "true");

    if (error) {
      error.textContent = message;
      error.hidden = false;
    }
  }

  function setStatus(message: string, state: "idle" | "error" = "idle") {
    if (!status) return;

    const isError = state === "error";
    status.textContent = message;
    status.classList.toggle("text-destructive", isError);
    status.classList.toggle("text-muted-foreground", !isError);
    status.setAttribute("role", isError ? "alert" : "status");
    status.setAttribute("aria-live", isError ? "assertive" : "polite");
  }

  fieldNames.forEach(name => {
    getFieldElements(name).control?.addEventListener("input", () => {
      clearFieldError(name);
    });
  });

  form?.addEventListener("submit", async event => {
    event.preventDefault();

    if (!form.reportValidity()) return;

    const originalLabel = submitLabel?.textContent ?? "Send message";

    clearFieldErrors();
    setStatus("");
    form.setAttribute("aria-busy", "true");

    if (submit) {
      submit.disabled = true;
    }

    spinner?.classList.remove("hidden");
    if (submitLabel) {
      submitLabel.textContent = "Sending message";
    }

    try {
      const { error } = await actions.sendContact(new FormData(form));

      if (error) {
        let hasFieldErrors = false;

        if (isInputError(error)) {
          fieldNames.forEach(name => {
            const message = error.fields[name]?.[0];

            if (message) {
              hasFieldErrors = true;
              setFieldError(name, message);
            }
          });
        }

        setStatus(
          hasFieldErrors
            ? "Please check the highlighted fields."
            : error.message || "An error occurred. Please try again.",
          "error",
        );
        return;
      }

      form.reset();
      setStatus("Message sent successfully.");
    } catch {
      setStatus("Unable to send your message. Please try again.", "error");
    } finally {
      form.removeAttribute("aria-busy");

      if (submit) {
        submit.disabled = false;
      }

      spinner?.classList.add("hidden");
      if (submitLabel) {
        submitLabel.textContent = originalLabel;
      }
    }
  });
</script>
