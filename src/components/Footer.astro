---
import { CONTACT_EMAIL, GITHUB_URL, LINKEDIN_URL } from "@/lib/constants";

const year = new Date().getFullYear();

const links = [
  { name: "GitHub", href: GITHUB_URL },
  { name: "LinkedIn", href: LINKEDIN_URL },
  { name: "Resume", href: "/resume" },
  { name: "Email", href: `mailto:${CONTACT_EMAIL}` },
];
---

<footer class="mt-24 border-t border-border">
  <div
    class="mx-auto flex max-w-5xl flex-col-reverse gap-6 px-5 py-9 sm:flex-row sm:items-end sm:justify-between sm:px-10"
  >
    <p class="font-mono text-xs leading-7 text-faint">
      &copy; {year} Stas Bronevskiy
    </p>

    <nav
      class="flex flex-wrap gap-5 font-mono text-[13px] text-muted-foreground"
      aria-label="Footer"
    >
      {
        links.map(link => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={
              link.href.startsWith("http") ? "noopener noreferrer" : undefined
            }
            class="transition-colors hover:text-primary"
          >
            {link.name}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
