---
import { cn } from "@/lib/utils";
import { Separator } from "@/components/ui/separator";

interface Props {
  label: string;
  level?: 1 | 2;
  class?: string;
}

const { label, level = 2, class: className } = Astro.props;
const Heading = level === 1 ? "h1" : "h2";
---

<div class={cn("flex items-center justify-center gap-3", className)}>
  <Separator className="max-w-11 flex-1" />
  <Heading
    class="font-mono text-xs tracking-[0.18em] text-muted-foreground uppercase"
  >
    {label}
  </Heading>
  <Separator className="max-w-11 flex-1" />
</div>
