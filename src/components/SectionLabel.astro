---
import { cn } from "@/lib/utils";

interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div class={cn("flex items-center justify-center gap-3", className)}>
  <span class="h-px w-11 bg-border"></span>
  <span
    class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground"
  >
    {label}
  </span>
  <span class="h-px w-11 bg-border"></span>
</div>
