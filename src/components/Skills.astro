---
import Tags from "@/components/Tags.astro";
import { Separator } from "@/components/ui/separator";
import type { TagName } from "@/lib/tags";

const groups: { name: string; tags: TagName[] }[] = [
  {
    name: "Languages",
    tags: ["typescript", "go", "java", "rust", "cpp"],
  },
  {
    name: "Frontend",
    tags: ["react", "tailwind-css", "vite", "shadcn-ui"],
  },
  {
    name: "Backend & Data",
    tags: ["node", "bun", "postgres"],
  },
  {
    name: "Tools & Technologies",
    tags: ["webassembly", "websocket", "git", "stripe", "ai-sdk"],
  },
];
---

<div class="mx-auto grid max-w-3xl gap-x-10 gap-y-7 sm:grid-cols-2">
  {
    groups.map(group => (
      <div>
        <h3 class="flex items-center gap-3 font-mono text-xs tracking-[0.12em] text-primary uppercase">
          {group.name}
          <Separator className="flex-1" />
        </h3>
        <Tags tags={group.tags} variant="secondary" class="mt-3" />
      </div>
    ))
  }
</div>
