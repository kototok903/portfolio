---
import { Image } from "astro:assets";
import { ArrowUpRightIcon } from "@lucide/astro";
import { LinkButton } from "@/components/LinkButton";
import { Card, CardBar } from "@/components/ui/card";
import Tags from "@/components/Tags.astro";
import { projectsData } from "@/lib/projects";

interface Props {
  count?: number;
}

const { count } = Astro.props;
const projects = count ? projectsData.slice(0, count) : projectsData;
---

<div class="grid gap-4 sm:grid-cols-2">
  {
    projects.map((project, i) => (
      <Card className="group gap-0 overflow-hidden border-border py-0 transition-colors hover:border-primary">
        <CardBar>
          <span>{project.displayFilename}</span>
          <span>P/{String(i + 1).padStart(2, "0")}</span>
        </CardBar>

        {project.image && (
          <Image
            src={project.image}
            alt={`${project.title} screenshot`}
            class="h-40 w-full border-b border-border object-cover object-top"
          />
        )}

        <div class="flex flex-1 flex-col p-6">
          <h3 class="font-serif text-2xl italic tracking-tight">
            {project.title}
          </h3>
          <p
            class="mt-2 text-[15px] text-muted-foreground"
            set:html={project.description}
          />

          {project.tags && <Tags tags={project.tags} class="mt-4" />}

          <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-5 font-mono text-[13px]">
            {project.links?.map(link => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-primary-hi hover:text-primary hover:underline"
              >
                {link.label}
                <ArrowUpRightIcon class="size-3.5" aria-hidden />
              </a>
            ))}
            {project.githubUrl && (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-primary-hi hover:text-primary hover:underline"
              >
                Source
                <ArrowUpRightIcon class="size-3.5" aria-hidden />
              </a>
            )}
          </div>
        </div>
      </Card>
    ))
  }
</div>

{
  count && projectsData.length > count && (
    <div class="mt-7 flex justify-center">
      <LinkButton href="/projects" variant="frame">
        All projects ({projectsData.length})
        <ArrowUpRightIcon aria-hidden />
      </LinkButton>
    </div>
  )
}
