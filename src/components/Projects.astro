---
import { Image } from "astro:assets";
import { ArrowUpRightIcon } from "@lucide/astro";
import { LinkButton } from "@/components/LinkButton";
import {
  Card,
  CardBar,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import Tags from "@/components/Tags.astro";
import { projectsData } from "@/lib/projects";

interface Props {
  count?: number;
  headingLevel?: 2 | 3;
}

const { count, headingLevel = 3 } = Astro.props;
const projects = count ? projectsData.slice(0, count) : projectsData;
const ProjectHeading = headingLevel === 2 ? "h2" : "h3";
---

<div class="grid gap-4 sm:grid-cols-2">
  {
    projects.map((project, i) => (
      <article class="flex">
        <Card variant="terminal" className="flex-1">
          <CardBar>
            <span>{project.displayFilename}</span>
            <!-- TODO: maybe add project date here -->
          </CardBar>

          {project.image && (
            <Image
              src={project.image}
              alt={`${project.title} screenshot`}
              class="h-40 w-full border-b border-border object-cover object-top"
            />
          )}

          <CardHeader className="pt-6">
            <CardTitle>
              <ProjectHeading class="font-serif text-2xl font-normal tracking-tight italic">
                {project.title}
              </ProjectHeading>
            </CardTitle>
            <CardDescription className="text-[15px]">
              <p set:html={project.description} />
            </CardDescription>
          </CardHeader>

          {project.tags && (
            <CardContent className="pt-4">
              <Tags tags={project.tags} />
            </CardContent>
          )}

          <CardFooter className="mt-auto flex-wrap gap-x-5 gap-y-2 pb-6 pt-5 font-mono text-[13px]">
            {project.links?.map(link => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-primary-hi hover:text-primary hover:underline"
              >
                {link.label}
                <ArrowUpRightIcon class="size-3.5" aria-hidden />
              </a>
            ))}
            {project.githubUrl && (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-primary-hi hover:text-primary hover:underline"
              >
                Source
                <ArrowUpRightIcon class="size-3.5" aria-hidden />
              </a>
            )}
          </CardFooter>
        </Card>
      </article>
    ))
  }
</div>

{
  count && projectsData.length > count && (
    <div class="mt-7 flex justify-center">
      <LinkButton href="/projects" variant="frame">
        All projects ({projectsData.length})
        <ArrowUpRightIcon aria-hidden />
      </LinkButton>
    </div>
  )
}
