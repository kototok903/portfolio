---
import Header from "@/components/Header";
import Footer from "@/components/Footer.astro";
import CropMarks from "@/components/CropMarks.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Stas' Portfolio",
  description = "Stas Bronevskiy's personal computer science portfolio",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1c2130" />
    <link rel="icon" href="/public/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col font-sans antialiased">
    <CropMarks />
    <Header pathname={Astro.url.pathname} client:load />
    <main class="grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
