---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Intro from "@/components/Intro.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import WorkExperience from "@/components/WorkExperience.astro";
import Projects from "@/components/Projects.astro";
import Skills from "@/components/Skills.astro";
import ContactForm from "@/components/ContactForm.astro";

const sectionClass =
  "mx-auto max-w-5xl scroll-mt-24 px-5 pb-24 sm:px-10 md:pb-32";
---

<BaseLayout>
  <Intro />

  <section id="work" class={sectionClass}>
    <SectionLabel label="Work Experience" class="mb-10" />
    <div class="mx-auto max-w-3xl">
      <WorkExperience />
    </div>
  </section>

  <section id="projects" class={sectionClass}>
    <SectionLabel label="Projects" class="mb-10" />
    <Projects count={4} />
  </section>

  <section id="skills" class={sectionClass}>
    <SectionLabel label="Skills & Stack" class="mb-10" />
    <Skills />
  </section>

  <section id="contact" class={sectionClass}>
    <SectionLabel label="Contact" class="mb-10" />
    <ContactForm />
  </section>
</BaseLayout>
