---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { LinkButton } from "@/components/LinkButton";
import { ArrowLeftIcon } from "@lucide/astro";
---

<BaseLayout title="Not Found | Stas' Portfolio">
  <section
    class="mx-auto flex min-h-[60vh] max-w-5xl flex-col items-center justify-center px-5 py-24 text-center sm:px-10"
  >
    <p class="font-mono text-xs tracking-[0.2em] text-primary uppercase">
      error · 404
    </p>
    <h1 class="mt-4 text-5xl font-bold tracking-tight sm:text-6xl">
      Page <span class="font-serif font-normal text-primary italic"
        >not found</span
      >.
    </h1>
    <p class="mt-4 text-muted-foreground">
      The page you are looking for does not exist.
    </p>
    <div class="mt-8">
      <LinkButton href="/" variant="handle">
        <ArrowLeftIcon aria-hidden />
        Back home
      </LinkButton>
    </div>
  </section>
</BaseLayout>
