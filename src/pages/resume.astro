---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import { LinkButton } from "@/components/LinkButton";
import { DownloadIcon } from "@lucide/astro";

const resumePreviewUrl =
  "https://drive.google.com/file/d/16xGqgVDR2kOtHW93LB6xWMO1aRzlvRjz/preview";
const resumeDownloadUrl =
  "https://drive.google.com/uc?export=download&id=16xGqgVDR2kOtHW93LB6xWMO1aRzlvRjz";
---

<BaseLayout title="Resume | Stas' Portfolio">
  <section class="mx-auto max-w-3xl px-5 py-20 sm:px-10">
    <SectionLabel label="Resume" level={1} class="mb-8" />

    <div class="mb-6 flex justify-center">
      <LinkButton
        href={resumeDownloadUrl}
        target="_blank"
        rel="noopener noreferrer"
        variant="handle"
      >
        <DownloadIcon aria-hidden />
        Download PDF
      </LinkButton>
    </div>

    <div class="relative w-full border border-border-strong pt-[141.42%]">
      <iframe
        src={resumePreviewUrl}
        title="Resume PDF preview"
        class="absolute top-0 left-0 h-full w-full"
        loading="lazy"></iframe>
    </div>
  </section>
</BaseLayout>
