---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import Projects from "@/components/Projects.astro";
---

<BaseLayout
  title="Projects | Stas Bronevskiy"
  description="Projects by Stas Bronevskiy: a client-only PDF editor, an AI translation workspace for fiction, a BetterDiscord theme editor, a Rust + WebAssembly sorting visualizer and more."
>
  <section class="mx-auto max-w-5xl px-5 py-20 sm:px-10">
    <SectionLabel label="All Projects" level={1} class="mb-10" />
    <Projects headingLevel={2} />
  </section>
</BaseLayout>
